# ===== .env.example — متغيرات البيئة لـ «يهماء» =====

# ⚠️ ملاحظة مهمة: التطبيق شغال static بالكامل (Vanilla JS) ومفيش
# build step، والـSupabase client بيتعمل في core/auth-boot.js مباشرة.
# فالمتغيرات دي **مش تُقرأ من الملف ده** وقت التشغيل — هي توثيق
# للمُشغّل: وين القيم الحقيقية بتتخزّن وإزاي تتحط.
#
# ⭐ الأسماء هنا لازم تطابق اللي الـEdge Functions بتطلبه بالظبط
# (Deno.env.get). لو الاسم اختلف، الدالة هتشتغل بـundefined وتفشل
# برسالة غامضة.
#
# - الواجهة الأمامية: نفس الرابط والمفتاح موجودين في core/auth-boot.js
#   (المفتاح anonymous — public بأمان، مش سري).
# - قيم الـEdge Functions: تتخزّن أسرار، مش ملفات.
# - قيمة CACHE_NAME في sw.js هي رقم الإصدار الفعلي الوحيد.

# --- Supabase (Edge Functions / scripts) ---
# https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://dzildqysxdlnfsmjttjg.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImR6aWxkcXlzeGRsbmZzbWp0dGpnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAwNTU3NTMsImV4cCI6MjEwNTYzMTc1M30.UdcML-28I0ndel65IMBxfG7wMOZjRK9ZlrjTj_JFyVc
# ⚠️ الاسم ده YAHMA_SERVICE_ROLE_KEY مش SUPABASE_SERVICE_KEY —
#   الـEdge Functions بتطلبه بالاسم ده بالظبط.
#   مفتاح service_role — سري جدًا. حُط كـsecret:
#   supabase secrets set YAHMA_SERVICE_ROLE_KEY=...
YAHMA_SERVICE_ROLE_KEY=your-service-role-key-here

# --- إرسال الإيميل: Resend (الطريقة الأساسية) ---
# https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here
# عنوان المُرسِل — لازم يكون عند Resend (نطاق مُتحقق منه)
RESEND_FROM_EMAIL=notifications@your-domain.com

# --- إرسال الإيميل: EmailJS (طريقة بديلة احتياطية) ---
# https://dashboard.emailjs.com → Account → API Keys
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PRIVATE_KEY=your_private_key

# --- رابط المنصة ---
# بيتّسخ في روابط الإيميل (تسجيل الدخول، استعادة كلمة المرور)
YAHMA_SITE_URL=https://yahma-app.acc-mahmoud-hassan9096.workers.dev

# --- الجدولة السحابية (Cron) ---
# سر طويل وعشوائي — بيتقارن في scheduled-email-setup.sql.
#   supabase secrets set YAHMA_CRON_SECRET=$(openssl rand -hex 32)
# ⛔ ما يتحطش في أي واجهة أمامية.
YAHMA_CRON_SECRET=replace-with-a-long-random-secret

# --- الإعدادات ---
# رقم إصدار الـservice worker موجود في sw.js (CACHE_NAME) — وده
# المصدر الوحيد. هنا مش بنكرّره عشان ما يبقاش رقم قديم في مكانين.
# YAHMA_APP_VERSION=yahma-shell-vNNN
