# ===== .env.example — متغيرات البيئة لـ «يهماء» =====
# انسخ هذا الملف إلى `.env` وأ填 القيم الفعلية.
# مفيش أي قيمة حقيقية هنا — كل هي placeholders.

# --- Supabase (الواجهة الأمامية) ---
# lien proyecto من Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://dzildqysxdlnfsmjttjg.supabase.co

# مفتاح anonymous (public) — للاستخدام في المتصفح فقط
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImR6aWxkcXlzeGRsbmZzbWp0dGpnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAwNTU3NTMsImV4cCI6MjEwNTYzMTc1M30.UdcML-28I0ndel65IMBxfG7wMOZjRK9ZlrjTj_JFyVc

# --- Supabase (لسيرفر Cloudflare Workers فقط) ---
# مفتاح الخدمة (service_role) — سري جداً، لا يوضع في المتصفح
# يُضبط عبر: wrangler secret put SUPABASE_SERVICE_KEY
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- إرسال الإيميل (Resend) ---
# للحصول على مفتاح: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# --- واتساب أعمال (Twilio) ---
# للحصول على البيانات: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+1415xxxxxxx

# --- تكوين التطبيق ---
# رقم الإصدار الحالي (يُحدّث تلقائياً من sw.js عند النشر)
YAHMA_APP_VERSION=yahma-shell-v326

# --- تحكم في الميزات ---
YAHMA_ENABLE_2FA=false
YAHMA_ENABLE_BACKUP=false
YAHMA_ENABLE_EXPIRY_ALERTS=false
